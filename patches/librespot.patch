+    /// Orders the default context like the client that started playback.
+    ///
+    /// `criteria` is the comma separated `sorting.criteria` of a play command,
+    /// e.g. `added_at DESC,album_title,original_index`. Keys a track has no
+    /// metadata for are skipped, and ties keep the order of the context
+    /// itself, so `None` restores that order.
+    pub fn sort_context(&mut self, criteria: Option<&str>) -> Result<(), StateError> {
+        let keys: Vec<(&str, bool)> = criteria
+            .unwrap_or_default()
+            .split(',')
+            .filter_map(|key| {
+                let mut parts = key.split_whitespace();
+                let name = parts.next()?;
+                let descending = parts.next().is_some_and(|o| o.eq_ignore_ascii_case("desc"));
+                Some((name, descending))
+            })
+            .collect();
+
+        let ctx = self.get_context_mut(ContextType::Default)?;
+        ctx.tracks.sort_by(|a, b| {
+            for &(key, descending) in &keys {
+                let order = if key == "original_index" {
+                    a.get_context_index().cmp(&b.get_context_index())
+                } else {
+                    match (a.metadata.get(key), b.metadata.get(key)) {
+                        (Some(a), Some(b)) => match (a.parse::<i64>(), b.parse::<i64>()) {
+                            (Ok(a), Ok(b)) => a.cmp(&b),
+                            _ => a.cmp(b),
+                        },
+                        // tracks without the key go last, regardless of the direction
+                        (Some(_), None) => return std::cmp::Ordering::Less,
+                        (None, Some(_)) => return std::cmp::Ordering::Greater,
+                        (None, None) => std::cmp::Ordering::Equal,
+                    }
+                };
+                let order = if descending { order.reverse() } else { order };
+                if order.is_ne() {
+                    return order;
+                }
+            }
+            a.get_context_index().cmp(&b.get_context_index())
+        });
+
+        match criteria {
+            Some(criteria) => ctx
+                .metadata
+                .insert("sorting.criteria".to_string(), criteria.to_string()),
+            None => ctx.metadata.remove("sorting.criteria"),
+        };
+
+        Ok(())
+    }
+
